<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ─── Identidad del proyecto ─────────────────────────────────────── -->
    <groupId>com.rappifavor</groupId>
    <artifactId>rappifavor-backend</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>Rappi Favor Backend</name>
    <description>Plataforma de delivery de favores universitaria — ITESO 2026</description>

    <!-- ─── Java 15 ────────────────────────────────────────────────────── -->
    <properties>
        <maven.compiler.source>15</maven.compiler.source>
        <maven.compiler.target>15</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Versiones de dependencias -->
        <sparkjava.version>2.9.4</sparkjava.version>
        <mongodb.version>4.11.1</mongodb.version>
        <firebase.version>9.2.0</firebase.version>
        <gson.version>2.10.1</gson.version>
        <slf4j.version>2.0.9</slf4j.version>
        <dotenv.version>3.0.0</dotenv.version>
        <junit.version>5.10.0</junit.version>
        <mockito.version>5.6.0</mockito.version>
    </properties>

    <dependencies>

        <!-- ─── Spark Java: framework REST ligero para Java ─────────────
             Elegido sobre Spring Boot por su bajo overhead y compatibilidad
             nativa con Heroku sin configuración adicional.
             Docs: https://sparkjava.com/
        ──────────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>com.sparkjava</groupId>
            <artifactId>spark-core</artifactId>
            <version>${sparkjava.version}</version>
        </dependency>

        <!-- ─── MongoDB Driver: acceso a MongoDB Atlas ──────────────────
             Driver oficial de MongoDB para Java. Usamos el driver síncrono
             ya que Spark Java es bloqueante por naturaleza.
        ──────────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>mongodb-driver-sync</artifactId>
            <version>${mongodb.version}</version>
        </dependency>

        <!-- ─── Firebase Admin SDK: autenticación y Realtime DB ─────────
             Permite verificar tokens JWT emitidos por Firebase Auth
             y acceder a Firebase Realtime DB desde el backend.
        ──────────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>com.google.firebase</groupId>
            <artifactId>firebase-admin</artifactId>
            <version>${firebase.version}</version>
        </dependency>

        <!-- ─── Gson: serialización/deserialización JSON ────────────────
             Usado para convertir objetos Java a JSON en los endpoints REST.
        ──────────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- ─── SLF4J + Logback: logging ────────────────────────────── -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.4.11</version>
        </dependency>

        <!-- ─── Dotenv: leer variables de entorno desde .env ────────────
             En Heroku se usan Config Vars; localmente con Podman se usa .env
        ──────────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>${dotenv.version}</version>
        </dependency>

        <!-- ─── Testing: JUnit 5 + Mockito ──────────────────────────── -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- Compilador Java 15 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>15</source>
                    <target>15</target>
                </configuration>
            </plugin>

            <!-- Plugin para crear JAR ejecutable (fat JAR) con todas las
                 dependencias incluidas. Heroku ejecuta: java -jar target/*.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <!-- Define la clase Main para el JAR ejecutable -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.rappifavor.RappiFavorApplication</mainClass>
                                </transformer>
                                <!-- Combina archivos de configuración de servicios -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- JUnit 5 runner -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <!-- Necesario para que Mockito/ByteBuddy funcione con Java 21+ -->
                    <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
